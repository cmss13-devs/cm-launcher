{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm install",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": []
    },
    {
      "label": "Dev",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "tauri-dev",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:"
        },
        "pattern": {
          "regexp": "^$"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Dev (HWID)",
      "type": "shell",
      "command": "bash ./scripts/with-hwid.sh npm run dev",
      "dependsOn": ["npm install"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "tauri-dev-hwid",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:"
        },
        "pattern": {
          "regexp": "^$"
        }
      }
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "npm run tauri -- build",
      "dependsOn": ["npm install"],
      "problemMatcher": []
    },
    {
      "label": "Build (CM)",
      "type": "shell",
      "command": "npm run tauri -- build --config src-tauri/tauri.cm.conf.json -- --features cm_ss13",
      "dependsOn": ["npm install"],
      "problemMatcher": []
    },
    {
      "label": "Build (HWID)",
      "type": "shell",
      "command": "bash ./scripts/with-hwid.sh npm run tauri -- build -- --features hwid",
      "dependsOn": ["npm install"],
      "problemMatcher": []
    }
  ]
}
